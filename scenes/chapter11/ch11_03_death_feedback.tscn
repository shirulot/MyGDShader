[sub_resource type="GDScript" id="GDScript_xakcb"]
script/source = "extends Node

# 保留你在 11.2 写好的 HP 与受击通知；死亡规则也由代理负责。
var max_hp := 100
@export var hp := max_hp
signal damage();
signal health_changed(hp, max_hp);

# TODO：声明 died 信号，并保存是否已经进入死亡状态。

func _on_simulate_damage_pressed() -> void:
	# TODO：已死亡时忽略新的伤害；首次降到 0 时只发死亡通知。
	hp = clamp(hp - 25, 0, max_hp)
	health_changed.emit(hp, max_hp)
	# 下面是原来的普通受击通知，由你增加死亡 / 存活的分支。
	damage.emit();
"

[sub_resource type="GDScript" id="GDScript_22xnp"]
script/source = "extends Node

# 存活时使用 11.2 已完成的材质；溶解材质作为独立输入由场景提供。
@export var death_material: ShaderMaterial
@onready var robot: Sprite2D = $\"../Robot\"
@onready var hp_label: Label = $\"../HPLabel\"

var tween: Tween = null

func _ready() -> void:
	$\"../DamageProxy\".damage.connect(_on_damaged);
	$\"../DamageProxy\".health_changed.connect(_update_hp)
	var proxy = $\"../DamageProxy\"
	_update_hp(proxy.hp, proxy.max_hp)
	# TODO：连接死亡通知，并显式初始化溶解材质的进度为 0。

func _update_hp(hp: int, max_hp: int) -> void:
	hp_label.text = \"HP：%d（满血 %d）\" % [hp, max_hp]
	var danger_progress = clamp(1.0 - hp * 1.0 / max_hp, 0.0, 1.0);
	robot.material.set_shader_parameter(\"danger_progress\", danger_progress);

func _on_damaged() -> void:
	# 保留你已通过的瞬时受击逻辑。
	if tween != null && tween.is_valid():
		tween.kill()
	tween = create_tween()
	robot.material.set_shader_parameter(\"white_flash\", 1.0);
	tween.tween_property(robot.material, \"shader_parameter/white_flash\", 0.0, 0.3);

func _on_died() -> void:
	# TODO：中止并复位受击反馈，切换到 death_material，再驱动溶解。
	# 死亡开始 / 动画完成 / 隐藏是不同的时刻，本步先做到溶解完成。
	pass
"

[sub_resource type="Shader" id="Shader_3yfwf"]
code = "shader_type canvas_item;

// C05 已完成算法的独立副本；本节复用，不修改旧作品。
// TEXTURE 提供机器人颜色，noise_texture 提供溶解阈值数据。
uniform sampler2D noise_texture : filter_linear, repeat_disable;
uniform float dissolve_progress : hint_range(0.0, 1.0, 0.01) = 0.0;
uniform float edge_width : hint_range(0.01, 0.2, 0.01) = 0.05;
uniform vec3 line_color = vec3(1.0, 0.55, 0.1);

void fragment() {
	vec4 origin = texture(TEXTURE, UV);
	vec4 noise = texture(noise_texture, UV);
	float weight = step(dissolve_progress, noise.r);
	float smoothWeight = smoothstep(dissolve_progress, dissolve_progress + edge_width, noise.r);
	if (dissolve_progress >= 1.0) {
		weight = 0.0;
	}
	if (weight == 0.0) {
		discard;
	}
	if (weight - smoothWeight > 0.0 && dissolve_progress > 0.0) {
		vec3 last_line_color = mix(line_color, origin.rgb, smoothWeight);
		COLOR = vec4(last_line_color, origin.a);
	} else {
		COLOR = origin;
	}
}
"

