; 独立审查工程：不引入主项目autoload、课程代码或旧版素材。
config_version=5

[application]
config/name="Ember connected pixel review"
run/main_scene="res://review.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1344
window/size/viewport_height=804
window/size/window_width_override=1120
window/size/window_height_override=670
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.047,0.075,0.094,1)
