; 完整八向素材的独立检查工程，不修改游戏主工程。
config_version=5
[application]
config/name="Robot v011 eight-way actions"
run/main_scene="res://preview_full_actions.tscn"
[display]
window/size/viewport_width=960
window/size/viewport_height=640
[rendering]
renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.094,0.149,0.192,1)
