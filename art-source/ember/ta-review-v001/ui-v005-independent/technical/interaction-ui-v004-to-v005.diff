+			current_focus.value += current_focus.step * (-1 if event.button_index == JOY_BUTTON_DPAD_LEFT else 1)
+		return true
+	if event.button_index == JOY_BUTTON_START:
+		if event.pressed and page.is_empty():
+			open_pause()
+		return true
