  {
    "id": "channel_edge_n",
    "sources": [
      "art-source/ember/tilesets-v001/generated/channel_module_master_v001.png"
    ],
    "adjustments": [
      "裁出新水岸母稿的钢板主面与黄铜铆接条作为材质参考",
      "重建12像素岸带和1像素外轮廓",
      "固定全部岸线端口[10,22)，凸角/凹角按真实连接方向分别登记",
      "水侧冷色包边留在岸体内部，水域保持真实透明",
      "转角重新绘制左上亮暗与铆接像素，避免旋转造成光照漂移",
      "删除半透明外晕和杂点，固定16色及0/255 Alpha",
      "岸线接口kind细分为局部水侧N/E/S/W，排除水陆方向相反的同宽物理口"
    ],
    "interfaces": {
      "N": null,
      "E": {
        "kind": "channel-bank-12px-water-N-v001",
        "ports": [
          [
            10,
            22
          ]
        ],
        "alpha_at_ports": "opaque",
        "exact_edge_required": false
      },
      "S": null,
      "W": {
        "kind": "channel-bank-12px-water-N-v001",
        "ports": [
          [
            10,
            22
          ]
        ],
        "alpha_at_ports": "opaque",
        "exact_edge_required": false
      }
    },
    "native_size": [
      32,
      32
    ],
    "method": "AI_MATERIAL_REFERENCE_AND_NATIVE_PIXEL_FINISH",
    "layout_topology": {
      "connected_sides": [
        "E",
        "W"
      ],
      "water_sides": [
        "N"
      ],
      "corner_semantics": "外角为陆地凸出；内角为水域凹入；方向指水侧",
      "water_surface_included": false
