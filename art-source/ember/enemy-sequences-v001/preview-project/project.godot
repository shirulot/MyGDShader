; 独立序列预览工程，不加载正式游戏的 Game 单例。
config_version=5

[application]
config/name="Ember enemy sequence review"

[display]
window/size/viewport_width=1536
window/size/viewport_height=1024

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.09,0.14,0.16,1)

